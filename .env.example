# Acumatica instance. No trailing slash.
ACUMATICA_BASE_URL=https://qualitytrackequipment.acumatica.com

# Tenant login names from Tenants (SM203520), separated by |
ACUMATICA_TENANTS=Quality Track Equipment|Quality Track Equipment - Test

# Contract-based REST endpoint names and versions.
# Open Web Service Endpoints (SM207060) and match what is published.
ACUMATICA_DEFAULT_ENDPOINT=Default
ACUMATICA_DEFAULT_VERSION=24.200.001
ACUMATICA_MANUFACTURING_ENDPOINT=MANUFACTURING
ACUMATICA_MANUFACTURING_VERSION=24.200.001

# Machine sales order type. Both default to MS.
# To convert a quote into a different order type, set the quote type
# to a quote-behavior order type and leave the sales order type as MS.
ACUMATICA_QUOTE_ORDER_TYPE=MS
ACUMATICA_SALES_ORDER_TYPE=MS
ACUMATICA_CONVERT_QUOTE_ACTION=ConvertQuoteToOrder

# Optional branch ID sent at sign-in. Leave blank to use the user's default.
ACUMATICA_BRANCH=
ACUMATICA_LOCALE=en-US

# Create quotes, orders, and production orders on hold.
ACUMATICA_CREATE_ON_HOLD=true

# Source value written on the production order when it is linked to the sales order.
ACUMATICA_PRODUCTION_SOURCE=Sales Order

# Send Usr* custom fields. Leave false until those fields exist on the endpoint.
# Until then, the same values are written to the document note.
ACUMATICA_SEND_CUSTOM_FIELDS=false

# Required for live sign-in. Encrypts the Acumatica session cookie.
# Generate with: openssl rand -base64 32
# The password is never written into this cookie.
SESSION_SECRET=

# Hide the password form and allow only demo mode.
QTE_DEMO_ONLY=false
